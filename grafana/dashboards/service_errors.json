{
  "uid": "service-errors",
  "title": "Service Errors",
  "tags": ["astro-reason", "errors"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Errors (24h)",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM service_error_events WHERE created_at >= NOW() - INTERVAL '24 hours';"
        }
      ],
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors (7d)",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM service_error_events WHERE created_at >= NOW() - INTERVAL '7 days';"
        }
      ],
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Services with Errors (24h)",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT service) AS value FROM service_error_events WHERE created_at >= NOW() - INTERVAL '24 hours';"
        }
      ],
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Errors by Service (7d)",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT service, COUNT(*) AS errors FROM service_error_events WHERE created_at >= NOW() - INTERVAL '7 days' GROUP BY service ORDER BY errors DESC;"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 4 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors Over Time",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', created_at) AS \"time\", COUNT(*) AS value, service AS metric FROM service_error_events WHERE $__timeFilter(created_at) GROUP BY 1, 3 ORDER BY 1;"
        }
      ],
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 4 }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent Error Events",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at, service, stage, status, error, meta FROM service_error_events WHERE $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 200;"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 }
    }
  ]
}
